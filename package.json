{
  "name": "@avilaops/publicacao-texto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./js/publicacao.d.ts",
      "default": "./js/publicacao.mjs"
    },
    "./arquivos": {
      "types": "./js/arquivos.d.ts",
      "default": "./js/arquivos.mjs"
    },
    "./descoberta": {
      "types": "./js/descoberta.d.ts",
      "default": "./js/descoberta.mjs"
    },
    "./descoberta/navegador": {
      "types": "./js/descoberta-navegador.d.ts",
      "default": "./js/descoberta-navegador.mjs"
    },
    "./descoberta/arquivos": {
      "types": "./js/descoberta-arquivos.d.ts",
      "default": "./js/descoberta-arquivos.mjs"
    }
  },
  "bin": {
    "publicar-texto": "./bin/publicar-texto.mjs",
    "publicar-descoberta": "./bin/publicar-descoberta.mjs"
  },
  "files": [
    "js",
    "bin",
    "docs/descoberta-publica.md"
  ],
  "scripts": {
    "test": "node --test tests-js/*.test.mjs"
  },
  "dependencies": {
    "@mixmark-io/domino": "2.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "parse5": "8.1.1",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "esbuild": "0.28.2",
    "remark-frontmatter": "5.0.0"
  }
}
